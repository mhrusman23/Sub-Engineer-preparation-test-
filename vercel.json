{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "sub-engineer-23.vercel.app" }],
      "destination": "https://ppscengr.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/papers", "destination": "/papers-hub.html" },
    { "source": "/papers/", "destination": "/papers-hub.html" },
    { "source": "/papers/:file", "destination": "/:file" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
